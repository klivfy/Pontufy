# URL do sistema Pontufy (aplicação com login).
# O botão "Entrar na Plataforma" da landing page aponta para esta URL.
# Em produção (Vercel), configure em Project Settings > Environment Variables.
# Local: VITE_APP_URL="http://localhost:3000" (com `npm run dev:pontufy` no app).
VITE_APP_URL="https://pontufy.com"
