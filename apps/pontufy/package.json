{
  "name": "pontufy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:ai": "tsx scripts/test-course-engine.mjs",
    "eval:ai": "tsx scripts/eval-courses.mjs",
    "dev": "next dev --webpack -p 3000",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "node scripts/lint-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint:ci && npm run check:routes",
    "check:routes": "node scripts/check-route-guards.mjs",
    "db:deploy": "node scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.74",
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/genai": "^2.9.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.208",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.44.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.2.2",
    "swr": "^2.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
