# ─── Required ────────────────────────────────────────────────────────────────

# Signs NextAuth session JWTs. MANDATORY in production — without it, tokens can
# be forged. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# PostgreSQL connection. On serverless (Vercel) DATABASE_URL must be a POOLED
# endpoint (PgBouncer / Neon pooler / Supabase pooler on port 6543), e.g.:
#   postgresql://user:pass@host:6543/db?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host:6543/pontufy?pgbouncer=true&connection_limit=1"

# Direct (unpooled) connection used by `prisma migrate`. OPTIONAL: on Vercel the
# build falls back to DATABASE_URL when DIRECT_URL is unset. Set it only when
# DATABASE_URL is a transaction-mode pooler that can't run migrations (then point
# this at the direct host/port, e.g. 5432). For local `prisma migrate dev`, set
# it equal to DATABASE_URL if you don't have a separate direct endpoint.
DIRECT_URL="postgresql://user:password@host:5432/pontufy"

# Vercel Marketplace (Supabase) injects prefixed names. The app also accepts
# these if DATABASE_URL / DIRECT_URL are unset. Keys only — never commit values.
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# KLIV_PONT_POSTGRES_PRISMA_URL=
# KLIV_PONT_POSTGRES_URL=
# KLIV_PONT_POSTGRES_URL_NON_POOLING=

# ─── Local development (Docker Postgres — docker compose up -d db) ────────────
# A stack na raiz do repositório sobe o Postgres 16 com as credenciais abaixo.
# Copie este arquivo para .env.local e descomente:
# DATABASE_URL="postgresql://pontufy:pontufy@localhost:5432/pontufy"
# DIRECT_URL="postgresql://pontufy:pontufy@localhost:5432/pontufy"
# Depois: npm run db:migrate && npm run db:seed
# AUTH_SECRET="use-a-fonte-de-desenvolvimento-com-32-bytes-minimos"

# ─── Optional integrations (features degrade gracefully if unset) ─────────────
# ATENÇÃO: "degrada graciosamente" vale para e-mail, IA e cupons. NÃO vale para
# Redis e para os segredos de webhook abaixo — veja as seções marcadas.

# Canonical app URL (used for password-reset / setup links in emails).
# Production login is https://pontufy.com/login. AUTH_URL is the Auth.js v5 alias.
# NEXTAUTH_URL="https://pontufy.com"
# AUTH_URL="https://pontufy.com"

# Supabase Auth (Google OAuth). Server also reads KLIV_PONT_* and
# NEXT_PUBLIC_KLIV_PONT_KLIVSUPABASE_* (Vercel Marketplace). Client components
# need a NEXT_PUBLIC_ key — Marketplace already injects
# NEXT_PUBLIC_KLIV_PONT_KLIVSUPABASE_URL / _ANON_KEY / _PUBLISHABLE_KEY.
# Do not put SERVICE_ROLE in the browser.
# NEXT_PUBLIC_SUPABASE_URL="https://vowmmgbhgcozdqvdcldh.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_URL=
# KLIV_PONT_SUPABASE_URL=
# Redirect allow-list no dashboard Supabase (Authentication → URL Configuration):
#   Site URL: https://pontufy.com
#   Additional Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://pontufy.com/auth/callback
#     https://www.pontufy.com/auth/callback
#     https://pontufy.com/login
#     https://www.pontufy.com/login

# Transactional email (Resend). Without it, emails are logged to the console.
# RESEND_API_KEY=""
# EMAIL_FROM="Pontufy <noreply@pontufy.com>"

# AI course generation — the first configured provider is used.
# Ordem de prioridade: Gemini > OpenAI > Anthropic
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Caching & rate limiting (Upstash Redis).
# OBRIGATÓRIO EM PRODUÇÃO. Sem Upstash:
#   • rate limit e account lockout viram no-op (proteção contra brute force desligada);
#   • revogação de sessão (revoke-all) não funciona;
#   • SSE e contadores de notificação degradam.
# O core (concluir aula, resgatar) continua funcionando: a correção do saldo vive
# no UPDATE condicional do banco, e o mutex sem Redis vira no-op.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Stripe payments.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Affiliate network (Lomadee).
# LOMADEE_APP_TOKEN=""
# LOMADEE_SOURCE_ID=""

# ─── Segredos de webhook/verificação (OBRIGATÓRIOS em produção) ───────────────
# Sem estes valores os endpoints correspondentes ficam FECHADOS (503), nunca
# abertos. Já foram opcionais e isso permitia cunhar pontos sem autenticação.

# Assina o postback de rede de afiliados: HMAC-SHA256(secret, "<timestamp>.<body>").
# AFFILIATE_WEBHOOK_SECRET="gere-com-openssl-rand-hex-32"
# Teto (em BRL) para aceitar uma comissão; acima disso o postback é recusado.
# AFFILIATE_MAX_COMMISSION_VALUE="50000"

# Protege POST /api/postback/lomadee (header `x-pontufy-token`, ou ?token= por
# compatibilidade com o cadastro existente na Lomadee).
# LOMADEE_POSTBACK_SECRET="gere-com-openssl-rand-hex-32"

# Assina certificados (HMAC-SHA256). Mínimo 32 caracteres.
# CERTIFICATE_VERIFICATION_SECRET="gere-com-openssl-rand-hex-32"

# Protects cron endpoints (Authorization: Bearer <CRON_SECRET>).
# OBRIGATÓRIO: os crons são fail-closed e só aceitam este header.
# CRON_SECRET=""

# ─── Limites de provisionamento (V3) ────────────────────────────────────────
# Kill switch de custo. Contados no banco (tabela ProvisioningQuota), então
# funcionam mesmo com o Redis fora.
# Empresas criadas por dia (padrão 50).
# PROVISION_MAX_TENANTS_PER_DAY="50"
# Créditos de IA concedidos por dia, somando todos os trials (padrão 100).
# PROVISION_MAX_AI_CREDITS_PER_DAY="100"

# ─── Somente ambiente local (nunca em produção) ──────────────────────────────
# Bootstrap manual de dados:
#   SEED_ADMIN_PASSWORD='...' npx tsx scripts/check-and-seed.ts
# Endpoint /api/setup/seed (responde 404 quando NODE_ENV=production ou VERCEL_ENV existe):
# SETUP_SECRET=""            # mínimo 24 caracteres
# SETUP_ADMIN_PASSWORD=""    # mínimo 12 caracteres
# SEED_ADMIN_PASSWORD=""     # mínimo 12 caracteres
