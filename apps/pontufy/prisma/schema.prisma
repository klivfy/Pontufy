generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// Modelo de Dados Core - Pontufy B2B MVP
// ═══════════════════════════════════════════════════════════════════════

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?  @default("#10B981") // Padrão Verde Esmeralda Pontufy
  accentColor     String?  @default("#8B5CF6") // Padrão Lavanda/Roxo
  customDomain    String?  @unique
  sector          String   // 'tech', 'health', 'retail', 'industry'
  contractStatus  String   @default("active") // 'active', 'suspended', 'cancelled'
  plan            String   @default("trial") // 'trial', 'starter', 'enterprise'
  trialEndsAt     DateTime?
  aiCredits       Int      @default(20)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus   String?  // 'active', 'past_due', 'canceled', 'trialing'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locale          String   @default("pt-BR")  // 'pt-BR', 'en', 'es'

  users              User[]
  courses            Course[]
  pointsLedger       PointsLedger[]
  pointsLots         PointsLot[]
  rewards            Reward[]
  invitations        Invitation[]
  lessonCompletions  LessonCompletion[]
  commissions        Commission[]
  notifications      Notification[]
  stripeEvents       StripeEvent[]
  auditLogs          AuditLog[]
  quizAttempts       QuizAttempt[]
  skills             Skill[]
  skillNodes         SkillNode[]
  userSkillProgress  UserSkillProgress[]
  battles            Battle[]
  redemptions        Redemption[]
  emailVerifications EmailVerification[]
  uploadQuotas        UploadQuota[]
}

model User {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String?  // scrypt: "<salt>:<hash>". Null only for legacy/migrated accounts.
  role            String   @default("employee") // 'admin_rh', 'employee', 'guest'
  pointsBalance   Int      @default(0)
  department      String?  // TAREFA 13.2 — departamento p/ ranking interdepartamental
  /// Revogação de sessão SEM Redis (V5): cada emissão de JWT carrega a versão
  /// atual; incrementar aqui derruba todas as sessões do usuário.
  sessionVersion  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  pointsLedger        PointsLedger[]
  pointsLots          PointsLot[]
  lessonCompletions   LessonCompletion[]
  passwordReset       PasswordReset?
  issuedCertificates  IssuedCertificate[]
  commissions         Commission[]
  notifications       Notification[]
  skillProgress       UserSkillProgress[]
  battlesChallenged   Battle[]             @relation("BattleChallenger")
  battlesOpposed      Battle[]             @relation("BattleOpponent")
  auditLogs           AuditLog[]
  quizAttempts        QuizAttempt[]
  redemptions         Redemption[]
  emailVerifications  EmailVerification[]

  @@index([tenantId])
  @@index([tenantId, pointsBalance])
}

model Course {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  description     String?
  aiCreditsSpent  Int      @default(0)
  quizJson        Json?    // A3: array de módulos (validado por schemas/quiz.ts)
  status          String   @default("draft") // 'draft', 'published'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  lessons         Lesson[]
  quizAttempts    QuizAttempt[]
  skillNodes      SkillNode[]

  workloadHours   Int      @default(0) // Carga horária oficial do curso (certificado). 0 = fallback para nº de aulas.

  @@index([tenantId])
}

model Lesson {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  type            String   // 'video', 'text'
  contentUrl      String?  @db.Text
  pointsAssigned  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId])
}

model LessonCompletion {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([tenantId])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  courseId  String
  score     Int
  total     Int
  passed    Boolean  @default(false) // score/total >= 70% (server-side)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([tenantId])
}


// ═══════════════════════════════════════════════════════════════════════════
// A1 — Lote de pontos
//
// O saldo (User.pointsBalance) é um número; o ledger diz que houve ganhos e
// perdas, mas não QUANTO de cada ganho ainda está disponível. Sem isso, a
// expiração era heurística: "soma dos ganhos antigos menos soma das expirações",
// que pode expirar pontos de um ganho recente e não expirar os do antigo.
//
// Cada gain gera um lote com "remaining" e "expiresAt". O consumo (resgate ou
// expiração) acontece por lote, do que vence primeiro para o que vence depois
// (FIFO por validade), e o invariante é:
//
//   SUM(PointsLot.remaining) == User.pointsBalance
//
// sourceLedgerId é único: um crédito gera no máximo um lote (idempotência).
// ═══════════════════════════════════════════════════════════════════════════
model PointsLot {
  id             String   @id @default(uuid())
  userId         String
  tenantId       String
  /// Valor original do crédito.
  amount         Int
  /// Quanto ainda não foi consumido (resgate ou expiração).
  remaining      Int
  expiresAt      DateTime
  sourceLedgerId String?  @unique
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, expiresAt])
  @@index([expiresAt, remaining])
  @@index([tenantId])
}
model PointsLedger {
  id              String   @id @default(uuid())
  userId          String
  tenantId        String
  type            String   // 'gain', 'loss'
  pointsAmount    Int
  description     String
  timestamp       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([userId, timestamp])
}

model Reward {
  id              String   @id @default(uuid())
  tenantId        String?  // Null = global reward available to all tenants.
  partner         String   @default("LOMADEE") // 'LOMADEE', 'amazon', 'magalu', 'shopee', 'mercadolivre'
  externalId      String?  // ID do produto/oferta na Lomadee
  title           String
  originalUrl     String   // URL original do produto/oferta
  affiliateUrl    String?  // URL afiliada gerada (com tracking)
  pricePoints     Int
  imageUrl        String?
  category        String?  // 'tech', 'health', 'home', 'coupons', etc.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([partner])
  @@index([category])
  @@index([externalId])
}

// ═══════════════════════════════════════════════════════════════════════
// Resgates de Recompensas (Lomadee / Afiliados)
// ───────────────────────────────────────────────────────────────────────
// Registro imutável de cada resgate efetuado pelo colaborador.
// O link afiliado é gerado no momento do resgate com trackingSubId único
// para atribuição de comissões via postback.
// ═══════════════════════════════════════════════════════════════════════

model Redemption {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String
  rewardId        String
  pointsDebited   Int
  trackingSubId   String   @unique // UUID único para atribuição de comissão (subId)
  affiliateLink   String   // Link afiliado gerado no momento do resgate
  status          String   @default("PENDING") // 'PENDING' | 'CONFIRMED' | 'CANCELLED'
  commissionValue Decimal? @db.Decimal(12, 2)
  postbackPayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([rewardId])
  @@index([trackingSubId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ═══════════════════════════════════════════════════════════════════════════
// Verificação de e-mail do tenant (V3 do SEGURANCA-ESTRUTURAL.md)
// ───────────────────────────────────────────────────────────────────────────
// Tenant criado pelo formulário público nasce em `contractStatus =
// 'pending_verification'` com `aiCredits = 0`. Os créditos de trial só são
// concedidos — e o login liberado — quando o e-mail é provado por este token.
// Substitui o provisionamento implícito que criava empresa para qualquer login
// Google desconhecido, sem limite e com 20 créditos de IA.
// ═══════════════════════════════════════════════════════════════════════════

model EmailVerification {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  tenantId  String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
}

// Contadores diários de provisionamento. Kill switch de custo: limita quantos
// tenants nascem por dia e quantos créditos de IA são concedidos por dia.
// Vive no banco (não no Redis) para funcionar mesmo com a infra de cache fora.
model ProvisioningQuota {
  day       String   @id // YYYY-MM-DD (UTC)
  tenants   Int      @default(0)
  aiCredits Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Exclusão mútua de jobs (V7). Tabela em vez de pg_advisory_lock porque o app
// roda atrás de pooler (PgBouncer/Supabase): advisory locks são por sessão de
// conexão e o par acquire/release pode cair em conexões diferentes — o lock
// vazaria. Aqui o "claim" é um INSERT ... ON CONFLICT condicional, atômico e
// independente de conexão (e funciona sem Redis).
model JobLock {
  name      String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Quota diária de upload por tenant (V6, parte 2).
// O limite por requisição (5 arquivos / 12 MB) não impede um cliente de fazer
// a mesma chamada em sequência. Esta tabela mede o consumo do dia por tenant:
// é o que transforma "limite por lote" em "limite de uso".
model UploadQuota {
  tenantId  String
  day       String   // YYYY-MM-DD (UTC)
  files     Int      @default(0)
  bytes     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@index([day])
}

model AuditLog {
  id         String   @id @default(uuid())
  /// B5 — nullable: evento de PLATAFORMA (cron, provisionamento, migração)
  /// não pertence a um tenant de cliente.
  tenantId   String?
  userId     String?
  action     String   // ex.: "COURSE_CREATED", "USER_ROLE_UPDATED", "POINTS_MANUAL_ADJUST"
  entity     String   // ex.: "Course", "User", "Reward", "Tenant", "Invitation"
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  token     String   @unique
  role      String   @default("employee") // 'admin_rh', 'employee', 'guest'
  status    String   @default("pending") // 'pending', 'accepted', 'expired'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════════════════
// Idempotência de webhooks Stripe
// ───────────────────────────────────────────────────────────────────────
// Registro de eventos processados para impedir créditos/ativações duplicadas
// (Stripe redelivers até obter 2xx). `eventId` é único globalmente.
// ═══════════════════════════════════════════════════════════════════════

model StripeEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  type        String
  tenantId    String?
  /// 'processing' | 'processed' | 'failed' — permite reprocessar o que falhou
  /// em vez de tratar toda linha existente como "já processado".
  status      String   @default("processing")
  attempts    Int      @default(0)
  processedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([type])
  @@index([tenantId])
  @@index([status])
}

model IssuedCertificate {
  id               String   @id @default(uuid())
  userId           String
  tenantId         String
  courseId         String
  courseName       String
  verificationHash String?  @unique // Código único de verificação impresso no PDF
  signature        String?  // Assinatura HMAC-SHA256 para verificação criptográfica
  signedPayload    String?  @db.Text // Payload canônico EXATO que foi assinado (JSON, chaves ordenadas)
  issuedAt         DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════════════
// Notificações in-app (Centro de Notificações em Tempo Real)
// ───────────────────────────────────────────────────────────────────────
// Pertencem a um utilizador e tenant específicos (Zero Trust: leitura e
// escrita sempre via getTenantDb). `read` controla o badge não-lido.
// ═══════════════════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String   // "POINTS_EARNED" | "REWARD_REDEEMED" | "COURSE_ASSIGNED" | "LEVEL_UP" | "SYSTEM"
  read      Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Comissões de afiliados (Postback)
// ───────────────────────────────────────────────────────────────────────
// Registro persistente de cada postback recebido das redes afiliadas.
// Idempotência: um (tenantId, orderId, network) só pode ser processado
// uma vez — o crédito de pontos acontece dentro de uma $transaction.
// ═══════════════════════════════════════════════════════════════════════

model Commission {
  id              String   @id @default(uuid())
  tenantId        String
  network         String   // 'amazon', 'magalu', 'shopee', 'mercadolivre'
  trackingId      String
  userId          String
  orderId         String
  orderValue      Decimal  @db.Decimal(12, 2)
  commissionValue Decimal  @db.Decimal(12, 2)
  currency        String   @default("BRL")
  status          String   @default("pending") // 'pending', 'approved', 'rejected'
  pointsAwarded   Int      @default(0)
  receivedAt      DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, network, orderId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════
// TAREFA 12 — Trilhas de Competência e Árvore de Habilidades (Skill Tree)
// ───────────────────────────────────────────────────────────────────────
// Skill = competência corporativa (Liderança, Compliance, etc.).
// SkillNode = nó da árvore (módulo/curso) com posição (x,y), curso
// vinculado e pré-requisito opcional (12.3: aprovação >= requiredScore
// no nó anterior para desbloquear o próximo).
// UserSkillProgress = progresso do colaborador por nó: score % (quiz),
// status locked/available/in_progress/completed. PDI (12.5) = nó alvo
// atribuído pelo RH, materializado como registro com status
// "in_progress" e flag pdiTarget.
// ═══════════════════════════════════════════════════════════════════════

model Skill {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String   @default("general") // 'tech', 'health', 'retail', 'industry', 'leadership', 'compliance'
  targetLevel Int      @default(4) // nível-alvo de proficiência 1..5
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  nodes       SkillNode[]
  userProgress UserSkillProgress[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SkillNode {
  id              String    @id @default(uuid())
  skillId         String
  tenantId        String
  title           String
  description     String?
  x               Int       // posição na árvore (SVG viewBox)
  y               Int
  requiredScore   Int       @default(80) // % mínimo no pré-requisito
  courseId        String?
  prerequisiteId  String?   // nó que deve ser concluído antes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  skill           Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  course          Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  prerequisite    SkillNode?            @relation("SkillPrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  dependents      SkillNode[]           @relation("SkillPrerequisite")
  userProgress    UserSkillProgress[]

  @@index([skillId])
  @@index([tenantId])
  @@index([courseId])
}

model UserSkillProgress {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  skillId     String
  skillNodeId String
  score       Int      @default(0)      // % obtido no quiz vinculado (0 = não iniciado)
  status      String   @default("locked") // 'locked' | 'available' | 'in_progress' | 'completed'
  pdiTarget   Boolean  @default(false)  // 12.5 — nó apontado pelo PDI do RH
  updatedAt   DateTime @updatedAt

  skill      Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillNode  SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([userId, skillNodeId])
  @@index([tenantId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════
// TAREFA 13 — Batalhas de Conhecimento (desafio 1x1 assíncrono)
// ───────────────────────────────────────────────────────────────────────
// Uma linha por duelo: 5 questões geradas por IA sobre a trilha do tenant.
// Cada jogador responde seu turno de forma assíncrona (challenger/opponent);
// o servidor re-scora com questionsJson e valida o cronômetro de 15s (13.4).
// ═══════════════════════════════════════════════════════════════════════

model Battle {
  id                 String   @id @default(uuid())
  tenantId           String
  challengerId       String
  opponentId         String
  status             String   @default("pending") // 'pending' | 'challenger_done' | 'completed'
  questionsJson      Json                         // A3: { questions: [...] } validado por schemas/quiz.ts
  challengerScore    Int      @default(0)
  opponentScore      Int      @default(0)
  challengerElapsed  Int?     // segundos totais do turno (anti-trapaça)
  opponentElapsed    Int?
  forfeitedBy        String?  // turno anulado por perda de foco/tempo (13.4)
  winnerId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  expiresAt          DateTime // desafio expira se o oponente não responder

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  challenger   User   @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent     User   @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([challengerId])
  @@index([opponentId])
}
